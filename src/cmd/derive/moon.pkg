// The generator behind `#model.derive`, `#model.field` and `#model.skip`: the
// description of each annotated struct, as `T::describe()`. moonx runs it as a
// dev_build rule; see the README.
supported_targets = "+native+wasm"

pkgtype(kind: "executable")

import {
  "moonbitstack/moonast/quote",
  "moonbitstack/moonast/attr",
  "moonbitstack/moonast/gen",
  "moonbitstack/moonast/cli",
  "moonbitstack/moonmodel",
  "moonbitlang/parser/attribute",
  "moonbitlang/core/json",
  "moonbitlang/core/list",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}
