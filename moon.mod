name = "moonbitstack/moonmodel"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonmodel"

license = "Apache-2.0"

keywords = [
  "model",
  "schema",
  "data-model",
  "validation",
  "serialization",
  "serde",
  "json",
  "json-schema",
  "openapi",
  "sql",
  "ddl",
  "graphql",
  "sdl",
  "derive",
  "annotations",
  "pydantic",
  "mapping",
  "moonbit",
]

description = "One model description for MoonBit, projected to JSON Schema, OpenAPI, SQL and GraphQL."

import {
  "moonbitstack/moonast@0.2.3",
  "moonbitlang/parser@0.4.6",
  "moonbitlang/async@0.22.5",
}

source = "src"
