name = "moonbitstack/moonmodel"

version = "0.1.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonmodel"

license = "Apache-2.0"

keywords = [
  "model",
  "schema",
  "data-model",
  "validation",
  "validator",
  "serialization",
  "serde",
  "json",
  "json-schema",
  "openapi",
  "sql",
  "ddl",
  "graphql",
  "sdl",
  "derive",
  "annotations",
  "codegen",
  "binary",
  "byte-order",
  "endianness",
  "fixed-width",
  "layout",
  "pydantic",
  "mapping",
  "moonbit",
]

description = "One model description for MoonBit, projected to JSON Schema, OpenAPI, SQL and GraphQL."

import {
  "moonbitstack/moonast@0.2.6",
  "moonbitlang/parser@0.4.6",
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonschema@0.2.4",
}

source = "src"
